#version 450
// Exclusive prefix sum, step 1/3: each workgroup scans 1024 consecutive values
// and records its total. Step 2 scans the totals (radix_scan), step 3
// (scan_add) adds them back.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer In { uint values[]; };
layout(std430, binding = 1) writeonly buffer Out { uint prefix[]; };
layout(std430, binding = 2) writeonly buffer Blocks { uint block_sums[]; };
layout(std430, binding = 3) buffer Totals { uint totals[]; };

layout(push_constant) uniform Params {
  uint count;
  uint total_index;  // slot in totals[] that scan_add fills with the grand total
} pc;

const uint WG = 256u;
const uint ITEMS = 4u;

shared uint s_sum[WG];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint base = gl_WorkGroupID.x * WG * ITEMS + lid * ITEMS;
  uint v[ITEMS];
  uint total = 0u;
  for (uint k = 0u; k < ITEMS; ++k) {
    v[k] = base + k < pc.count ? values[base + k] : 0u;
    total += v[k];
  }
  s_sum[lid] = total;
  barrier();
  for (uint offset = 1u; offset < WG; offset <<= 1u) {
    uint add = lid >= offset ? s_sum[lid - offset] : 0u;
    barrier();
    s_sum[lid] += add;
    barrier();
  }
  uint running = s_sum[lid] - total;
  for (uint k = 0u; k < ITEMS; ++k) {
    if (base + k < pc.count) prefix[base + k] = running;
    running += v[k];
  }
  if (lid == WG - 1u) block_sums[gl_WorkGroupID.x] = s_sum[lid];
}
