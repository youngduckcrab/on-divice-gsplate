#version 450
// FP32 throughput: 4 independent vec4 FMA chains, unrolled 4x
// (64 FMA = 128 FLOP per loop iteration per thread).
layout(local_size_x = 256) in;

layout(std430, binding = 0) writeonly buffer Out { float result[]; };

layout(push_constant) uniform Params {
  uint iterations;
  float seed;
} pc;

void main() {
  uint i = gl_GlobalInvocationID.x;
  vec4 a = vec4(pc.seed + float(i & 1023u) * 1e-4);
  vec4 b = a + 0.25;
  vec4 c = a + 0.5;
  vec4 d = a + 0.75;
  const vec4 m = vec4(0.9999);
  const vec4 k = vec4(0.0001);
  for (uint it = 0u; it < pc.iterations; ++it) {
    a = fma(a, m, k); b = fma(b, m, k); c = fma(c, m, k); d = fma(d, m, k);
    a = fma(a, m, k); b = fma(b, m, k); c = fma(c, m, k); d = fma(d, m, k);
    a = fma(a, m, k); b = fma(b, m, k); c = fma(c, m, k); d = fma(d, m, k);
    a = fma(a, m, k); b = fma(b, m, k); c = fma(c, m, k); d = fma(d, m, k);
  }
  vec4 s = a + b + c + d;
  result[i] = s.x + s.y + s.z + s.w;
}
