#version 450
#extension GL_GOOGLE_include_directive : require
// Training pass 2: one key (the tile) per tile a gaussian touches. The
// gaussians come front to back (the depth sort), and each writes its pairs at
// its offset in that order (train_gather's scan): a stable sort by tile then
// leaves every tile's pairs front to back, as sorting (tile, depth) keys did,
// in fewer passes. A gaussian's pairs stay contiguous in this pre-sort order:
// the sort carries the pre-sort index along, the backward pass writes each
// pair's gradient back to it, and train_pair_sum finds them from offsets[].
layout(local_size_x = 128) in;

#include "train_common.glsl"

layout(std430, binding = 0) readonly buffer FrameBuf { FrameData frame; };
layout(std430, binding = 1) readonly buffer Projected { vec4 projected[]; };
layout(std430, binding = 2) readonly buffer Tiles { uint tiles_touched[]; };
layout(std430, binding = 3) readonly buffer SortedOffsets { uint sorted_offsets[]; };  // in depth order
layout(std430, binding = 4) writeonly buffer Keys { uint keys[]; };
layout(std430, binding = 5) writeonly buffer Values { uint values[]; };
layout(std430, binding = 6) writeonly buffer PairGaussian { uint pair_gaussian[]; };
layout(std430, binding = 7) writeonly buffer PairGrads { vec4 pair_grads[]; };
layout(std430, binding = 8) buffer Mismatch { uint mismatch[]; };  // gaussians whose count differed, ever
layout(std430, binding = 9) readonly buffer Order { uint order[]; };       // gaussians, front to back
layout(std430, binding = 10) writeonly buffer Offsets { uint offsets[]; };  // each gaussian's first pair

void main() {
  uint k = gl_GlobalInvocationID.x;
  if (k >= frame.model.x) return;
  uint i = order[k];
  if (tiles_touched[i] == 0u) return;
  vec4 q0 = projected[i * 4u];
  vec4 footprint = projected[i * 4u + 3u];
  uint p = sorted_offsets[k];
  offsets[i] = p;
  // Past the pair capacity the step is skipped (train_step); write nothing there.
  uint end = min(p + tiles_touched[i], frame.limits.x);
  uint wanted = 0u;
  ivec2 rows = footprint_rows(q0.xy, footprint.xyz, footprint.w, frame.image.y);
  if (rows.x <= rows.y) {
    for (uint ty = uint(rows.x) / kTile; ty <= uint(rows.y) / kTile; ++ty) {
      uvec2 span = footprint_row_tiles(q0.xy, footprint.xyz, footprint.w, rows, ty, frame.image.x);
      wanted += span.y - span.x;
      for (uint x = span.x; x < span.y && p < end; ++x) {
        keys[p] = ty * frame.image.z + x;
        values[p] = p;
        pair_gaussian[p] = i;
        ++p;
      }
    }
  }
  if (wanted == tiles_touched[i]) return;
  // train_project counted the same tiles, so this should not happen. If it
  // does, no slot is left stale: the rest go to the unused tile after the
  // last one, which no pass renders, with zero gradient.
  atomicAdd(mismatch[0], 1u);
  for (; p < end; ++p) {
    keys[p] = frame.image.z * frame.image.w;
    values[p] = p;
    pair_gaussian[p] = i;
    pair_grads[p * 3u] = vec4(0.0);
    pair_grads[p * 3u + 1u] = vec4(0.0);
    pair_grads[p * 3u + 2u] = vec4(0.0);
  }
}
