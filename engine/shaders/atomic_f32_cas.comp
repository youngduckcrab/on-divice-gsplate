#version 450
// Float atomic add emulated with a compare-and-swap loop on the bit pattern,
// for GPUs without VK_EXT_shader_atomic_float. Same access pattern as atomic_u32.
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Slots { uint slots[]; };

layout(push_constant) uniform Params {
  uint threads;
  uint slot_mask;
  uint per_thread;
} pc;

uint hash(uint x) {
  x ^= x >> 16u; x *= 0x7feb352du;
  x ^= x >> 15u; x *= 0x846ca68bu;
  x ^= x >> 16u;
  return x;
}

void atomic_add_f32(uint index, float value) {
  uint expected = slots[index];
  for (;;) {
    uint desired = floatBitsToUint(uintBitsToFloat(expected) + value);
    uint previous = atomicCompSwap(slots[index], expected, desired);
    if (previous == expected) break;
    expected = previous;
  }
}

void main() {
  uint tid = gl_GlobalInvocationID.x;
  if (tid >= pc.threads) return;
  for (uint j = 0u; j < pc.per_thread; ++j) {
    atomic_add_f32(hash(tid * pc.per_thread + j) & pc.slot_mask, 1.0);
  }
}
