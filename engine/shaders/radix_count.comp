#version 450
// Radix sort pass 1/3: per-block histogram of one 4-bit digit.
// Layout hist[digit * num_blocks + block], so an exclusive scan over the whole
// array gives every (digit, block) pair its global scatter offset.
layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Keys { uint keys[]; };
layout(std430, binding = 1) writeonly buffer Hist { uint hist[]; };

layout(push_constant) uniform Params {
  uint n;
  uint shift;
  uint num_blocks;
} pc;

const uint WG = 128u;
const uint ITEMS = 8u;

shared uint s_count[16];

void main() {
  uint lid = gl_LocalInvocationID.x;
  uint block = gl_WorkGroupID.x;
  if (lid < 16u) s_count[lid] = 0u;
  barrier();

  uint base = block * WG * ITEMS;
  for (uint i = 0u; i < ITEMS; ++i) {
    uint idx = base + i * WG + lid;
    if (idx < pc.n) atomicAdd(s_count[(keys[idx] >> pc.shift) & 15u], 1u);
  }
  barrier();

  if (lid < 16u) hist[lid * pc.num_blocks + block] = s_count[lid];
}
