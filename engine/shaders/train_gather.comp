#version 450
// Training pass 1c: the gaussians' tile counts in depth order, for the scan
// that places their pairs in that order (train_emit): sorted by tile alone
// afterwards (a stable sort), each tile's pairs are then front to back.
layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer Order { uint order[]; };    // gaussians, front to back
layout(std430, binding = 1) readonly buffer Tiles { uint tiles_touched[]; };
layout(std430, binding = 2) writeonly buffer Sorted { uint sorted_tiles[]; };

layout(push_constant) uniform Push {
  uint count;
} pc;

void main() {
  uint k = gl_GlobalInvocationID.x;
  if (k < pc.count) sorted_tiles[k] = tiles_touched[order[k]];
}
