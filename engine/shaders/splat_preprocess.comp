#version 450
// Viewer projection pass: for every splat, the EWA screen-space covariance, the
// ellipse axes, the view-dependent SH colour, and a 16-bit back-to-front depth
// key. Culled splats get key 0xffff so they sort last, and only visible splats
// are counted into the indirect draw.
layout(local_size_x = 256) in;

struct Splat {
  vec4 pos_opacity;  // xyz position, w opacity (after sigmoid)
  vec4 rotation;     // normalised quaternion (w, x, y, z)
  vec4 scale;        // xyz scale (after exp)
  vec4 sh_dc;        // xyz SH DC coefficient
};

layout(std430, binding = 0) readonly buffer Splats { Splat splats[]; };
layout(std430, binding = 1) readonly buffer ShRest { uint sh_rest[]; };  // fp16 pairs, [coeff][rgb]
layout(std430, binding = 2) writeonly buffer Projected { uvec4 projected[]; };
layout(std430, binding = 3) writeonly buffer Keys { uint keys[]; };
layout(std430, binding = 4) writeonly buffer Order { uint order[]; };
layout(std430, binding = 5) buffer DrawArgs {
  uint vertex_count;
  uint instance_count;
  uint first_vertex;
  uint first_instance;
} draw_args;

// Relighting by the backdrop's light (gs::SplatLighting); strength 0 is off.
layout(std430, binding = 6) readonly buffer Lighting {
  vec4 sh[9];     // irradiance SH (rgb), display space
  vec4 centre;    // the model's middle (scene); w: strength
  vec4 display;   // x: sign taking scene y and z to display
  vec4 key;       // main light direction (display)
  vec4 rim;       // rim light colour (rgb)
  uvec4 limit;    // x: relight only splats below this index (0: all)
  vec4 cut;       // feet height (scene y), radius, on (> 0): see-through cut for a place
} light;

// Posing (gs::SplatSkinning): the first `count` splats follow up to 4 bones
// each, their motions blended as dual quaternions (rigid: no shrinking).
layout(std430, binding = 7) readonly buffer Skin { uvec2 skin[]; };  // bone indices, weights: a byte each
layout(std430, binding = 8) readonly buffer Skinning {
  uvec4 info;    // x: splats posed, y: bones
  vec4 dq[64];   // per bone: rotation quaternion (w, x, y, z), then its dual part
} skinning;

layout(push_constant) uniform Params {
  vec4 rot0;        // scene -> camera rotation row 0, w = translation x
  vec4 rot1;
  vec4 rot2;
  vec4 cam_pos;     // camera centre in scene coordinates
  vec4 intrinsics;  // fx, fy, cx, cy
  uvec4 info;       // width, height, count, sh_degree | antialiased << 8
} pc;

const float kNear = 0.02;
const float kFar = 1000.0;
const float kDilation = 0.3;  // low-pass filter added to the 2D covariance, in px^2
const float kMinAlpha = 1.0 / 255.0;

float sh_half(uint base, uint h) {
  vec2 pair = unpackHalf2x16(sh_rest[base + (h >> 1u)]);
  return (h & 1u) == 0u ? pair.x : pair.y;
}

vec3 sh_coeff(uint base, uint j) {
  uint h = j * 3u;
  return vec3(sh_half(base, h), sh_half(base, h + 1u), sh_half(base, h + 2u));
}

// Real spherical harmonics up to degree 3, as used by 3D Gaussian Splatting.
vec3 eval_sh(vec3 dc, uint degree, uint base, vec3 d) {
  vec3 c = 0.28209479177387814 * dc;
  if (degree >= 1u) {
    float x = d.x, y = d.y, z = d.z;
    const float C1 = 0.4886025119029199;
    c += -C1 * y * sh_coeff(base, 0u) + C1 * z * sh_coeff(base, 1u) - C1 * x * sh_coeff(base, 2u);
    if (degree >= 2u) {
      float xx = x * x, yy = y * y, zz = z * z, xy = x * y, yz = y * z, xz = x * z;
      c += 1.0925484305920792 * xy * sh_coeff(base, 3u) +
           -1.0925484305920792 * yz * sh_coeff(base, 4u) +
           0.31539156525252005 * (2.0 * zz - xx - yy) * sh_coeff(base, 5u) +
           -1.0925484305920792 * xz * sh_coeff(base, 6u) +
           0.5462742152960396 * (xx - yy) * sh_coeff(base, 7u);
      if (degree >= 3u) {
        c += -0.5900435899266435 * y * (3.0 * xx - yy) * sh_coeff(base, 8u) +
             2.890611442640554 * xy * z * sh_coeff(base, 9u) +
             -0.4570457994644658 * y * (4.0 * zz - xx - yy) * sh_coeff(base, 10u) +
             0.3731763325901154 * z * (2.0 * zz - 3.0 * xx - 3.0 * yy) * sh_coeff(base, 11u) +
             -0.4570457994644658 * x * (4.0 * zz - xx - yy) * sh_coeff(base, 12u) +
             1.445305721320277 * z * (xx - yy) * sh_coeff(base, 13u) +
             -0.5900435899266435 * x * (xx - 3.0 * yy) * sh_coeff(base, 14u);
      }
    }
  }
  return max(c + 0.5, vec3(0.0));
}

vec3 srgb_to_linear(vec3 c) {
  return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

vec3 linear_to_srgb(vec3 c) {
  return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

vec3 irradiance(vec3 n) {
  const float x = n.x, y = n.y, z = n.z;
  return light.sh[0].rgb * 0.282095 + light.sh[1].rgb * (0.488603 * y) + light.sh[2].rgb * (0.488603 * z) +
         light.sh[3].rgb * (0.488603 * x) + light.sh[4].rgb * (1.092548 * x * y) +
         light.sh[5].rgb * (1.092548 * y * z) + light.sh[6].rgb * (0.315392 * (3.0 * z * z - 1.0)) +
         light.sh[7].rgb * (1.092548 * x * z) + light.sh[8].rgb * (0.546274 * (x * x - y * y));
}

// The splat's colour lit by the backdrop. Its normal is its thinnest axis
// turned away from the model's middle, leaning to "away from the middle" the
// rounder the splat is (and half way even for flat ones: trained splats'
// axes are noisy). Like a camera exposing for the subject, the light is
// partly normalised by what falls on the side facing the camera, and its
// direction is softened: a 2-band SH of a sunny sky is harsher than a photo
// of a person in it looks.
vec3 relight(vec3 color, vec3 p, mat3 R, vec3 scale, vec3 to_camera, vec3 middle_to_camera) {
  vec3 out_dir = p - light.centre.xyz;
  const float len = length(out_dir);
  out_dir = len > 1e-6 ? out_dir / len : vec3(0.0, 1.0, 0.0);
  int thin = scale.x < scale.y ? (scale.x < scale.z ? 0 : 2) : (scale.y < scale.z ? 1 : 2);
  const float smallest = scale[thin];
  const float middle = max(min(max(scale.x, scale.y), max(min(scale.x, scale.y), scale.z)), 1e-9);
  vec3 axis = normalize(R[thin]);
  if (dot(axis, out_dir) < 0.0) axis = -axis;
  const float flatness = 0.5 * clamp(1.0 - smallest / middle, 0.0, 1.0);
  vec3 n = normalize(mix(out_dir, axis, flatness));
  // Normal and view directions in display space, where the light is.
  const float s = light.display.x;
  n = vec3(n.x, n.y * s, n.z * s);
  const vec3 v = vec3(to_camera.x, to_camera.y * s, to_camera.z * s);
  const vec3 vm = vec3(middle_to_camera.x, middle_to_camera.y * s, middle_to_camera.z * s);
  const vec3 ambient = light.sh[0].rgb * 0.282095;
  const vec3 lit_n = mix(ambient, max(irradiance(n), vec3(0.0)), 0.6);
  const vec3 lit_v = mix(ambient, max(irradiance(vm), vec3(0.0)), 0.6);
  const vec3 luma = vec3(0.2126, 0.7152, 0.0722);
  const float exposure = mix(1.0, dot(lit_v, luma) / max(dot(ambient, luma), 1e-4), 0.5);
  // Rim: grazing to the camera, facing the light (strongest when the light is behind the model).
  const float grazing = pow(1.0 - clamp(dot(n, v), 0.0, 1.0), 3.0);
  const float facing = clamp(dot(n, light.key.xyz) * 0.75 + 0.25, 0.0, 1.0);
  const float behind = clamp(0.5 - 0.5 * dot(v, light.key.xyz), 0.0, 1.0);
  const vec3 gain = lit_n / max(exposure, 0.25) + light.rim.rgb * (grazing * facing * (0.3 + 0.7 * behind));
  const vec3 lit = linear_to_srgb(min(srgb_to_linear(min(color, vec3(1.0))) * gain, vec3(1.0)));
  return mix(color, lit, light.centre.w);
}

mat3 quat_to_matrix(vec4 q) {
  float w = q.x, x = q.y, y = q.z, z = q.w;
  // Column-major: each vec3 below is one column.
  return mat3(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y + w * z), 2.0 * (x * z - w * y),
              2.0 * (x * y - w * z), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z + w * x),
              2.0 * (x * z + w * y), 2.0 * (y * z - w * x), 1.0 - 2.0 * (x * x + y * y));
}

void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i >= pc.info.z) return;
  order[i] = i;

  Splat s = splats[i];
  vec3 p = s.pos_opacity.xyz;
  mat3 R = quat_to_matrix(s.rotation);
  // Posed: the blend of the bones' motions moves the centre and turns the
  // splat's axes; view directions are taken back to the rest pose for the SH.
  bool posed = i < skinning.info.x;
  mat3 B = mat3(1.0);  // the blend's rotation
  if (posed) {
    const uvec2 sk = skin[i];
    vec4 r = vec4(0.0), d = vec4(0.0), first = vec4(0.0);
    for (uint k = 0u; k < 4u; ++k) {
      const float w = float((sk.y >> (8u * k)) & 0xffu) / 255.0;
      if (w > 0.0) {
        const uint b = min((sk.x >> (8u * k)) & 0xffu, 31u) * 2u;
        const vec4 br = skinning.dq[b], bd = skinning.dq[b + 1u];
        if (k == 0u) first = br;
        const float sgn = dot(br, first) < 0.0 ? -w : w;
        r += sgn * br;
        d += sgn * bd;
      }
    }
    const float len = length(r);
    if (len > 1e-6) {
      r /= len;
      d /= len;
      B = quat_to_matrix(r);
      // Translation 2 (d r*), with r = (w, v): 2 (r.w d.v - d.w r.v + r.v x d.v).
      const vec3 rv = r.yzw, dv = d.yzw;
      const vec3 shift = 2.0 * (r.x * dv - d.x * rv + cross(rv, dv));
      p = B * p + shift;
      R = B * R;
    } else {
      posed = false;
    }
  }
  vec3 t = vec3(dot(pc.rot0.xyz, p) + pc.rot0.w,
                dot(pc.rot1.xyz, p) + pc.rot1.w,
                dot(pc.rot2.xyz, p) + pc.rot2.w);
  float opacity = s.pos_opacity.w;

  uvec4 out0 = uvec4(0u);
  uvec4 out1 = uvec4(0u);  // zero alpha marks a culled splat
  uint key = 0xffffu;

  // A place's splats between the camera and the model are cut away (the floor stays).
  bool cut_away = false;
  if (light.cut.z > 0.0 && light.limit.x != 0u && i >= light.limit.x) {
    const vec3 seg = light.centre.xyz - pc.cam_pos.xyz;
    const float len2 = max(dot(seg, seg), 1e-6);
    const vec3 rel = p - pc.cam_pos.xyz;
    const float along = dot(rel, seg) / len2;
    const float stop = 1.0 - 0.45 / sqrt(len2);  // leave what is right around the model
    const float height = (p.y - light.cut.x) * light.display.x;
    if (along > 0.0 && along < stop && height > 0.06) {
      cut_away = length(rel - seg * along) < light.cut.y;
    }
  }

  if (t.z > kNear && opacity >= kMinAlpha && !cut_away) {
    float fx = pc.intrinsics.x, fy = pc.intrinsics.y;
    float cx = pc.intrinsics.z, cy = pc.intrinsics.w;
    float width = float(pc.info.x), height = float(pc.info.y);
    float inv_z = 1.0 / t.z;
    vec2 center = vec2(fx * t.x * inv_z + cx, fy * t.y * inv_z + cy);

    // Evaluate the projection Jacobian no further than 1.3x outside the frustum.
    float lim_x = 1.3 * max(cx, width - cx) / fx;
    float lim_y = 1.3 * max(cy, height - cy) / fy;
    float tx = clamp(t.x * inv_z, -lim_x, lim_x);
    float ty = clamp(t.y * inv_z, -lim_y, lim_y);
    mat3 J = mat3(fx * inv_z, 0.0, 0.0,
                  0.0, fy * inv_z, 0.0,
                  -fx * tx * inv_z, -fy * ty * inv_z, 0.0);
    mat3 W = transpose(mat3(pc.rot0.xyz, pc.rot1.xyz, pc.rot2.xyz));
    mat3 M = mat3(R[0] * s.scale.x, R[1] * s.scale.y, R[2] * s.scale.z);
    mat3 T = J * W;
    mat3 cov = T * (M * transpose(M)) * transpose(T);

    float a = cov[0][0], b = cov[0][1], c = cov[1][1];
    float det_raw = a * c - b * b;
    a += kDilation;
    c += kDilation;
    float det = a * c - b * b;
    if ((pc.info.w & 0x100u) != 0u) {
      // Mip-splatting style compensation for scenes trained with it.
      opacity *= sqrt(max(det_raw, 0.0) / max(det, 1e-12));
    }

    if (det > 0.0 && opacity >= kMinAlpha) {
      float mid = 0.5 * (a + c);
      float spread = length(vec2(0.5 * (a - c), b));
      float l1 = mid + spread;
      float l2 = max(mid - spread, 0.1);
      vec2 v1 = vec2(b, l1 - a);
      float len = length(v1);
      v1 = len > 1e-12 ? v1 / len : vec2(1.0, 0.0);
      vec2 v2 = vec2(-v1.y, v1.x);
      // Quad corners sit at +-2 along each axis, i.e. 2.83 sigma.
      vec2 axis1 = v1 * min(sqrt(2.0 * l1), 2048.0);
      vec2 axis2 = v2 * min(sqrt(2.0 * l2), 2048.0);
      float extent = 2.0 * length(axis1);
      bool on_screen = center.x + extent > 0.0 && center.x - extent < width &&
                       center.y + extent > 0.0 && center.y - extent < height;
      if (on_screen) {
        uint degree = pc.info.w & 0xffu;
        uint coeffs = degree == 0u ? 0u : (degree + 1u) * (degree + 1u) - 1u;
        uint stride = (coeffs * 3u + 1u) / 2u;
        vec3 view_dir = normalize(p - pc.cam_pos.xyz);
        if (posed) view_dir = transpose(B) * view_dir;
        vec3 color = eval_sh(s.sh_dc.xyz, degree, i * stride, view_dir);
        if (light.centre.w > 0.0 && (light.limit.x == 0u || i < light.limit.x)) {
          color = relight(color, p, R, s.scale.xyz, normalize(pc.cam_pos.xyz - p),
                          normalize(pc.cam_pos.xyz - light.centre.xyz));
        }
        out0 = uvec4(floatBitsToUint(center), floatBitsToUint(axis1));
        out1 = uvec4(floatBitsToUint(axis2), packHalf2x16(color.rg), packHalf2x16(vec2(color.b, opacity)));
        // Log depth spreads the 16-bit key evenly across scales; far splats get small keys.
        float d = clamp(log2(t.z / kNear) / log2(kFar / kNear), 0.0, 1.0);
        key = 65534u - uint(d * 65534.0);
        atomicAdd(draw_args.instance_count, 1u);
      }
    }
  }

  projected[i * 2u] = out0;
  projected[i * 2u + 1u] = out1;
  keys[i] = key;
}
