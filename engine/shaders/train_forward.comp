#version 450
#extension GL_GOOGLE_include_directive : require
// Training pass 4: front-to-back alpha compositing of one 16x16 tile per
// workgroup, plus the L1 loss gradient per pixel and the tile's loss sums.
layout(local_size_x = 16, local_size_y = 16) in;

#include "train_common.glsl"

layout(std430, binding = 0) readonly buffer FrameBuf { FrameData frame; };
layout(std430, binding = 1) readonly buffer Projected { vec4 projected[]; };
layout(std430, binding = 2) readonly buffer Ranges { uvec2 ranges[]; };
layout(std430, binding = 3) readonly buffer Values { uint values[]; };
layout(std430, binding = 4) readonly buffer PairGaussian { uint pair_gaussian[]; };
layout(std430, binding = 5) readonly buffer Target { uint target[]; };  // RGBA8 per pixel
layout(std430, binding = 6) writeonly buffer PixelGrad { vec4 pixel_grad[]; };  // dL/dC rgb, final T
layout(std430, binding = 7) writeonly buffer PixelCount { uint pixel_count[]; };  // pairs up to the last contributor
layout(std430, binding = 8) writeonly buffer Image { uint image[]; };  // rendered RGBA8
// 4 per tile: [0] sum |e|, sum e^2, (SSIM sum, train_ssim), sum w |e|;
// [1] (sum w SSIM, train_ssim), sum w (per channel), head sum e^2, head pixels. w: pixel_weight.
// [2], [3]: for the view's brightness gain, over pixels where photo and model
// are both opaque: sum R^2 per channel and the pixel count, sum R P per
// channel (R the model's colour, P the photo's as taken).
layout(std430, binding = 9) writeonly buffer TileLoss { vec4 tile_loss[]; };
// Per tile, the largest per-pixel count: pairs behind it contribute to no pixel.
layout(std430, binding = 10) writeonly buffer TileCount { uint tile_count[]; };
// For the bucket backward pass (kFlagBucketState; see train_backward_bucket.comp):
// each pixel's front colour and T at the start of every 32 splats after the
// first, the buckets to process, and dL/dC . colour per pixel.
// Bucket states fill bucket_state, then bucket_state2: limits.z buckets each
// (two buffers reach twice the binding limit).
layout(std430, binding = 11) writeonly buffer BucketState { vec4 bucket_state[]; };
layout(std430, binding = 12) buffer BucketList { uint bucket_list[]; };  // count, then tile << 16 | bucket
layout(std430, binding = 13) writeonly buffer PixelDot { float pixel_dot[]; };
// kFlagSsim: render and target colour per pixel (2 per pixel) for train_ssim.
layout(std430, binding = 14) writeonly buffer SsimInput { vec4 ssim_input[]; };
layout(std430, binding = 15) writeonly buffer BucketState2 { vec4 bucket_state2[]; };

// Pixel `lid`'s state at the start of bucket slot `index` (bucket_base + k - 1).
// A slot past both buffers is not written: that step has more pairs than the
// state covers (limits.w), so its update is skipped and the bucket list left out.
void store_bucket_state(uint index, uint lid, vec4 value) {
  uint per = frame.limits.z;
  if (index < per) {
    bucket_state[index * (kTile * kTile) + lid] = value;
  } else if (index - per < per) {
    bucket_state2[(index - per) * (kTile * kTile) + lid] = value;
  }
}

const uint BATCH = 256u;
shared vec4 s_g0[BATCH];  // centre xy, opacity, unused
shared vec4 s_g1[BATCH];  // conic abc
shared vec4 s_g2[BATCH];  // colour
shared uint s_done;
shared vec2 s_loss[BATCH];
shared vec4 s_more[BATCH];  // sum w |e|, sum w, head sum e^2, head pixels
shared uint s_count[BATCH];

void main() {
  uint lid = gl_LocalInvocationIndex;
  uvec2 tile = gl_WorkGroupID.xy;
  uvec2 pix = tile * kTile + gl_LocalInvocationID.xy;
  uint width = frame.image.x, height = frame.image.y;
  bool inside = pix.x < width && pix.y < height;
  uint pix_id = pix.y * width + pix.x;
  vec2 center = vec2(pix) + 0.5;

  uint tile_id = tile.y * frame.image.z + tile.x;
  uvec2 range = ranges[tile_id];
  bool buckets = (frame.model.w & kFlagBucketState) != 0u;
  // Bucket k > 0 of this tile is stored at bucket_base + k - 1. The bases leave
  // gaps but never overlap: they grow by at least the tile's bucket count.
  uint bucket_base = range.x / 32u + tile_id;
  if (lid == 0u) s_done = 0u;
  barrier();

  bool done = !inside;
  float T = 1.0;
  vec3 C = vec3(0.0);
  uint contributor = 0u, last = 0u;
  for (uint start = range.x; start < range.y; start += BATCH) {
    if (done) atomicAdd(s_done, 1u);
    barrier();
    if (s_done == kTile * kTile) break;
    uint k = start + lid;
    if (k < range.y) {
      uint g = pair_gaussian[values[k]];
      vec4 q0 = projected[g * 4u];
      s_g0[lid] = vec4(q0.xy, q0.w, 0.0);
      s_g1[lid] = projected[g * 4u + 1u];
      s_g2[lid] = projected[g * 4u + 2u];
    }
    if (lid == 0u) s_done = 0u;
    barrier();
    uint n = min(BATCH, range.y - start);
    for (uint j = 0u; !done && j < n; ++j) {
      ++contributor;
      if (buckets && (contributor & 31u) == 1u && contributor > 1u) {
        store_bucket_state(bucket_base + (contributor >> 5u) - 1u, lid, vec4(C, T));
      }
      vec2 d = s_g0[j].xy - center;
      vec3 con = s_g1[j].xyz;
      float power = -0.5 * (con.x * d.x * d.x + con.z * d.y * d.y) - con.y * d.x * d.y;
      if (power > 0.0) continue;
      float alpha = min(kMaxAlpha, s_g0[j].z * exp(power));
      if (alpha < kMinAlpha) continue;
      float next_T = T * (1.0 - alpha);
      if (next_T < kMinTransmittance) {
        done = true;
        break;
      }
      C += s_g2[j].rgb * alpha * T;
      T = next_T;
      last = contributor;
    }
    barrier();
  }

  vec2 loss = vec2(0.0);
  vec4 more = vec4(0.0);
  if (inside) {
    vec3 bg = frame.background.rgb;
    vec3 out_color = C + T * bg;
    vec4 t = unpackUnorm4x8(target[pix_id]);
    vec3 photo = t.rgb * frame.exposure.rgb;  // at the model's brightness
    vec3 target_color = (frame.model.w & kFlagMaskedTarget) != 0u ? mix(bg, photo, t.a) : photo;
    vec3 e = out_color - target_color;
    // The L1 part; train_ssim_grad adds the D-SSIM part.
    float w = pixel_weight(frame.head, center);
    vec3 dL_dC = sign(e) * ((1.0 - frame.loss.x) * frame.background.w * w);
    if ((frame.model.w & kFlagSsim) != 0u) {
      ssim_input[pix_id * 2u] = vec4(out_color, w);
      ssim_input[pix_id * 2u + 1u] = vec4(target_color, 0.0);
    }
    pixel_grad[pix_id] = vec4(dL_dC, T);
    if (buckets) pixel_dot[pix_id] = dot(dL_dC, out_color);
    pixel_count[pix_id] = last;
    image[pix_id] = packUnorm4x8(vec4(clamp(out_color, 0.0, 1.0), 1.0 - T));
    loss = vec2(abs(e.r) + abs(e.g) + abs(e.b), dot(e, e));
    more = vec4(w * loss.x, 3.0 * w, in_head(frame.head, center) ? vec2(loss.y, 1.0) : vec2(0.0));
  }
  // The splat batches are done with s_g0, s_g1: they collect the gain sums.
  vec4 fit_rr = vec4(0.0), fit_rp = vec4(0.0);
  if (inside) {
    vec4 t = unpackUnorm4x8(target[pix_id]);
    if (t.a > 0.95 && T < 0.05) {
      fit_rr = vec4(C * C, 1.0);
      fit_rp = vec4(C * t.rgb, 0.0);
    }
  }
  s_g0[lid] = fit_rr;
  s_g1[lid] = fit_rp;
  s_loss[lid] = loss;
  s_more[lid] = more;
  s_count[lid] = last;
  barrier();
  for (uint stride = BATCH / 2u; stride > 0u; stride >>= 1u) {
    if (lid < stride) {
      s_loss[lid] += s_loss[lid + stride];
      s_more[lid] += s_more[lid + stride];
      s_count[lid] = max(s_count[lid], s_count[lid + stride]);
      s_g0[lid] += s_g0[lid + stride];
      s_g1[lid] += s_g1[lid + stride];
    }
    barrier();
  }
  if (lid == 0u) {
    tile_loss[tile_id * 4u] = vec4(s_loss[0], 0.0, s_more[0].x);
    tile_loss[tile_id * 4u + 1u] = vec4(0.0, s_more[0].yzw);
    tile_loss[tile_id * 4u + 2u] = s_g0[0];
    tile_loss[tile_id * 4u + 3u] = s_g1[0];
    tile_count[tile_id] = s_count[0];
    uint len = range.y - range.x;
    uint count = max(1u, (s_count[0] + 31u) / 32u);
    // Only tiles whose states were all stored (the others belong to a step whose update is skipped).
    if (buckets && len > 0u && (count == 1u || bucket_base + count - 2u < 2u * frame.limits.z)) {
      // At least one bucket, whose lanes also zero the pairs behind the last contributor.
      uint first = atomicAdd(bucket_list[0], count);
      for (uint k = 0u; k < count; ++k) bucket_list[1u + first + k] = (tile_id << 16u) | k;
    }
  }
}
